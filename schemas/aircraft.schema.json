{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RotorDesignLab aircraft v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "name", "units", "axes", "mass_properties", "rotors"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "aircraft"},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"}, "provenance": {"type": "string"},
    "units": {"const": "SI"}, "axes": {"const": "x_forward_y_right_z_down"},
    "mass_properties": {
      "type": "object", "additionalProperties": false,
      "required": ["mass_kg", "cg_m", "inertia_cg_kg_m2"],
      "properties": {
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "cg_m": {"$ref": "#/$defs/vector"},
        "inertia_cg_kg_m2": {"type":"array", "minItems":3, "maxItems":3, "items":{"$ref":"#/$defs/vector"}}
      }
    },
    "rotors": {
      "type": "array", "minItems": 1,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["id","blade_count","radius_m","pitch_reference_r_over_R","geometry_csv","polar_csv","position_m","thrust_axis_body","rotation_sign","defaults","limits"],
        "properties": {
          "id":{"type":"string","pattern":"^[a-zA-Z0-9_-]+$"},
          "description":{"type":"string"}, "provenance":{"type":"string"},
          "blade_count":{"type":"integer","minimum":2,"maximum":12},
          "radius_m":{"type":"number","minimum":0.03,"maximum":30},
          "pitch_reference_r_over_R":{"type":"number","exclusiveMinimum":0,"maximum":1},
          "geometry_csv":{"type":"string","minLength":1}, "polar_csv":{"type":"string","minLength":1},
          "position_m":{"$ref":"#/$defs/vector"}, "thrust_axis_body":{"$ref":"#/$defs/vector"},
          "rotation_sign":{"enum":[-1,1]},
          "defaults":{
            "type":"object","additionalProperties":false,"required":["rpm","collective_deg","radial_stations"],
            "properties":{
              "rpm":{"type":"number","minimum":1,"maximum":30000},
              "collective_deg":{"type":"number","minimum":-20,"maximum":55},
              "radial_stations":{"type":"integer","minimum":8,"maximum":2000}
            }
          },
          "limits":{
            "type":"object","additionalProperties":false,"required":["rpm","collective_deg"],
            "properties":{
              "rpm":{"$ref":"#/$defs/range"},"collective_deg":{"$ref":"#/$defs/range"},
              "power_w":{"type":"number","exclusiveMinimum":0},
              "torque_nm":{"type":"number","exclusiveMinimum":0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vector":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
    "range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}
  }
}
